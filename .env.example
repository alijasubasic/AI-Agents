# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored and must never be committed.
#
# IMPORTANT: every agent in this repo runs fully in DEMO MODE by default,
# backed by mock providers with synthetic fixture data. None of the values
# below are required for `make demo`, `make test` or `make lint` to pass.

# --- Execution mode -----------------------------------------------------
# "mock" (default) -> no network calls, deterministic scripted LLM responses
# "live"           -> real Anthropic API calls, requires ANTHROPIC_API_KEY
AGENT_MODE=mock

# --- Anthropic ----------------------------------------------------------
# Only needed when AGENT_MODE=live
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-opus-5

# --- Run limits (safety rails, applied in both modes) -------------------
AGENT_MAX_STEPS=8
AGENT_TIMEOUT_SECONDS=60
AGENT_MAX_COST_USD=1.00

# --- Tracing ------------------------------------------------------------
# Directory for per-run JSON traces. Git-ignored: traces embed prompts.
TRACE_DIR=traces
TRACE_ENABLED=true

# --- External services (all mocked by default) --------------------------
# Real implementations live behind the same interfaces as the mocks.
GOOGLE_CREDENTIALS_PATH=
CRM_API_BASE_URL=
CRM_API_TOKEN=

# --- Operator console (console/) ----------------------------------------
# Speech synthesis. "mock" (default) records a transcript and makes no network
# calls; "live" needs an ElevenLabs key and bills per character.
VOICE_MODE=mock
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Where the console records decisions as Obsidian notes. Defaults to a
# git-ignored `vault/` folder inside the repository, so a clone can never write
# into somebody's real notes by accident.
# The folder containing .obsidian/ — check this, because Obsidian often nests a
# vault inside a folder of the same name. Pointing one level too high puts the
# notes beside the vault, where Obsidian will never see them.
# Unquoted paths with spaces are fine.
OBSIDIAN_VAULT_PATH=

# --- Google: one credential for Calendar, Gmail and Drive -----------------
# Both paths must be OUTSIDE this repository. They hold a credential.
# Full walkthrough: docs/INTEGRATIONS.md
GOOGLE_CLIENT_SECRETS=
GOOGLE_TOKEN_PATH=

# --- Prospecting: the platforms (agents/prospecting) --------------------
# OpenStreetMap needs no key and is used whenever the CLI runs live.
# Google Places joins in only if this is set, and bills per request — the
# field mask in providers.py keeps that bill to the fields actually used.
GOOGLE_MAPS_API_KEY=

# --- Outreach: who the emails come from (agents/outreach) ---------------
# Required for --outreach. The footer of every message names them, and the
# run refuses to start if the first three are not all present.
OUTREACH_SENDER_NAME=
OUTREACH_SENDER_COMPANY=
OUTREACH_SENDER_EMAIL=
OUTREACH_SENDER_ROLE=
OUTREACH_SENDER_WEBSITE=
OUTREACH_SENDER_ADDRESS=
OUTREACH_SENDER_IMPRINT_URL=
# Stored but deliberately kept out of the message body — a phone number in
# outbound text trips codex article A5 on every single send.
OUTREACH_SENDER_PHONE=

# --- Outreach: sending (only used with --send) --------------------------
# Without all three, --send refuses and nothing leaves the machine.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
